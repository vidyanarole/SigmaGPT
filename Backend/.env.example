# Server Port
PORT=8080

# Production Frontend URL for CORS (e.g. https://your-sigmagpt.vercel.app)
# Leave blank for local development to allow localhost
CLIENT_URL=

# MongoDB Connection String (Local MongoDB or Atlas URI)
# Example local: mongodb://127.0.0.1:27017/sigmagpt
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sigmagpt?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sigmagpt

# --- AI Provider Configuration ---
# Choose provider: 'groq' (RECOMMENDED 100% FREE), 'openai', or 'openrouter'
AI_PROVIDER=groq

# Option 1: Groq (RECOMMENDED 100% FREE - Get instant free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: OpenAI (Requires paid credits)
OPENAI_API_KEY=your_openai_api_key_here

# Option 3: OpenRouter (Free tier models available at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides:
# AI_MODEL=qwen/qwen3.8-27b  # Supported Groq models: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions
